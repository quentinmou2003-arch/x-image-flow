{
  "manifest_version": 3,
  "name": "拾图 · X Image Flow",
  "version": "2.3.0",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "minimum_chrome_version": "116",
  "description": "X 图片和视频卡牌瀑布流、低清快速播放、原尺寸拼接、同步点赞和书签。",
  "permissions": ["activeTab", "clipboardWrite", "offscreen", "downloads", "storage"],
  "host_permissions": ["https://pbs.twimg.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "打开 / 关闭拾图（在 X 页面使用）", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}},
  "content_scripts": [
    {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["video-meta.js", "video-bridge.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["shared.js", "video-meta.js", "clipboard.js", "content.js"], "run_at": "document_idle"}
  ],
  "web_accessible_resources": [{"resources": ["ui.css"], "matches": ["https://x.com/*", "https://twitter.com/*"]}]
}
