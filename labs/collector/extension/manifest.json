{
  "manifest_version": 3,
  "name": "拾图 · 收藏实验室",
  "version": "2.4.0.4",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "description": "特别版：顺序收图、本地原图库、防漏清单、标签搜索与归档导出。",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "offscreen",
    "downloads",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://pbs.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 / 关闭拾图（在 X 页面使用）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "social-protocol.js",
        "social-bridge.js",
        "ad-filter.js",
        "video-meta.js",
        "video-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "shared.js",
        "social-protocol.js",
        "ad-filter.js",
        "video-meta.js",
        "clipboard.js",
        "native-menu.js",
        "collection-flow.js",
        "navigation.js",
        "auto-loader.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui.css"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ],
  "version_name": "2.4.0-lab.4"
}
